# TSS (Tijarah Samity Software) — Backend Environment Configuration Example
# Copy this file to .env before starting the server.

# Django Core Settings
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# PostgreSQL Database Configuration (Authoritative Target)
DATABASE_ENGINE=django.db.backends.postgresql
DATABASE_NAME=tss_db
DATABASE_USER=tss_user
DATABASE_PASSWORD=change-me-to-secure-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432

# CORS Configuration (Allowed Frontend Origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Sessions (Production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging Level
DJANGO_LOG_LEVEL=INFO
